# Clau de l'API d'OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=el_teu_codi_aquí
OPENAI_MODEL=gpt-4o-mini

# Configuració opcional
DEFAULT_LANGUAGE=cat+spa
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=fara-catala:latest

# Activar (TRUE) o desactivar (FALSE) el so en finalitzar
ENABLE_SOUND=TRUE

PYGAME_HIDE_SUPPORT_PROMPT=hide

# =============================================================================
# CONFIGURACIÓ DE LOGGING
# =============================================================================

# Nivell de logging: DEBUG, INFO, WARNING, ERROR (per defecte INFO)
LOG_LEVEL=INFO

# Directori on guardar els fitxers de log (per defecte "logs")
LOG_DIR=logs

# Activar colors a la consola (per defecte TRUE)
LOG_COLORS=TRUE

# Generar logs en format JSON estructurat (per defecte FALSE)
# Útil per a anàlisi amb eines com jq, Elasticsearch, etc.
LOG_JSON=FALSE

# Comprimir fitxers de log rotats amb gzip (per defecte TRUE)
LOG_COMPRESS=TRUE

# Mòduls a excloure dels logs (separats per comes)
# Exemple: LOG_EXCLUDE_MODULES=urllib3,PIL
LOG_EXCLUDE_MODULES=

# Format personalitzat dels logs (opcional)
# LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)-20s | %(message)s